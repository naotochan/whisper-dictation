{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicetauri/refs/heads/main/crates/tauri-cli/schema.json",
  "productName": "Flow",
  "version": "1.9.1",
  "identifier": "com.flow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "settings",
        "title": "Flow",
        "width": 740,
        "height": 640,
        "visible": false,
        "resizable": false,
        "center": true
      },
      {
        "label": "overlay",
        "url": "/?view=overlay",
        "title": "",
        "width": 200,
        "height": 44,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.openai.com https://api.anthropic.com https://github.com https://*.githubusercontent.com http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../stt-server.py": "stt-server.py",
      "../download-model.py": "download-model.py"
    },
    "macOS": {
      "infoPlist": "../Info.plist",
      "bundleVersion": "320",
      "signingIdentity": "Apple Development: naoto.k70@gmail.com (S27SCJ956H)",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzRDIyN0RDNDI4RUVGREYKUldUZjc0NUMzQ2ZTMC9wWnVCbnp3SWxvcStaM2RIY1RPWmdKekMwSFE0T2FLaW5DR0NQMUZONXMK",
      "endpoints": [
        "https://github.com/naotochan/whisper-dictation/releases/latest/download/latest.json"
      ]
    }
  }
}
